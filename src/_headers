# Cloudflare Pages response headers (this file is not published).
# HTML keeps Cloudflare's default (always revalidated), so text changes show immediately.

# Fonts never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS is inlined into every page (tools/inline-css.py), so there is no stylesheet request.

# Scripts carry the site version in their name (framenex-v20.min.js).
# Cached for a year: after editing a script, give it a new name (e.g. -v21) and update the HTML.
/javascript/*
  Cache-Control: public, max-age=31536000, immutable

# Images: 30 days. Use a NEW file name when you replace a picture, otherwise
# returning visitors may keep seeing the old one until the cache expires.
/compressed/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/partner/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logo.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Basic security headers for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# New photos uploaded through the CMS (resized automatically). Re-uploading under the same name: purge the cache.
/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
