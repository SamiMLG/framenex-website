---
layout: base.njk
pageKey: leistungen
permalink: side-pages/leistungen.html
---
{%- from "macros.njk" import image, crumbs, faqBlock, cta -%}
{%- set p = "../" -%}
{%- set d = fnx.leistungen -%}
<section aria-labelledby="page-title" class="page-hero page-hero--simple">
<div class="container page-hero-grid">
<div>
{{ crumbs([["Start", "../index.html"], ["Leistungen", ""]]) }}
<span class="eyebrow">Leistungen</span>
<h1 id="page-title">{{ d.hero.h1 }}</h1>
<p class="lead">{{ d.hero.lead }}</p>
<div class="btn-row"><a class="btn-primary" href="../index.html#contact">Kostenloses Erstgespräch</a><a class="btn-secondary" href="projekte.html">Referenzen ansehen</a></div>
</div>
</div>
</section>
<section aria-label="Leistungen im Detail" class="section">
<div class="container">
{%- for z in d.zeilen %}
<article class="overview-row">
<div><p class="num">{{ loop.index | pad2 }}</p><h3>{{ z.titel }}</h3><p>{{ z.text }}</p><p class="meta">{{ z.stichworte }}</p><a class="text-link" href="{{ z.seite }}.html">{{ z.linkText }} <span aria-hidden="true">→</span></a></div>
<a aria-label="{{ z.titel }} im Detail" class="overview-media" href="{{ z.seite }}.html">{{ image(z.img, z.alt, p, loop.first) }}</a>
</article>
{%- endfor %}
</div>
</section>
<section aria-labelledby="pricing-title" class="section section--raised">
<div class="container split">
<header><span class="eyebrow">Preis &amp; Planung</span><h2 id="pricing-title">{{ d.preis.titel }}</h2><p>{{ d.preis.text }}</p></header>
<div><dl class="rows">{% for f in d.preis.faktoren %}<div><dt>{{ f.label }}</dt><dd>{{ f.wert }}</dd></div>{% endfor %}</dl><p class="note">{{ d.preis.hinweis }}</p></div>
</div>
</section>
{{ faqBlock("faq-leistungen", d.faq.titel, d.faq.intro, d.faq.fragen, "faq.html") }}
{{ cta(d.cta.titel, d.cta.text, "../index.html?leistung=Sonstiges#contact") }}
