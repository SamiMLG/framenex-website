---
layout: base.njk
pageKey: home
permalink: index.html
---
{%- from "macros.njk" import image, faqBlock, contactForm -%}
{%- set p = "" -%}
{%- set d = fnx.home -%}
{%- set hero = d.hero -%}
<section aria-labelledby="hero-title" class="home-hero" id="hero">
<div aria-hidden="true" class="hero-media">
<picture class="hero-poster">
<source media="(max-width: 767px)" srcset="{{ fnx.heroPoster.mobile or fnx.heroPoster.src }}" type="image/webp"/>
<img alt="" decoding="async" fetchpriority="high" height="{{ fnx.heroPoster.height }}" src="{{ fnx.heroPoster.src }}" width="{{ fnx.heroPoster.width }}"/>
</picture>
<video aria-hidden="true" autoplay="" id="bg-video" loop="" muted="" playsinline="" preload="none" webkit-playsinline="">
<source data-src="{{ hero.videoAv1 }}" type="video/webm; codecs=av01"/>
<source data-src="{{ hero.videoH265 }}" type="video/mp4; codecs=hvc1"/>
<source data-src="{{ hero.videoH264 }}" type="video/mp4; codecs=avc1"/>
</video>
</div>
<div aria-hidden="true" class="hero-shade"></div>
<div class="hero-content">
<p class="hero-eyebrow">{{ hero.eyebrow }}</p>
<h1 id="hero-title"><span class="hero-brand">{{ hero.titelMarke }}</span> {{ hero.titel }}</h1>
<p class="hero-subtitle">{{ hero.untertitel }}</p>
<div class="btn-row">
<a class="btn-primary" href="#contact">{{ hero.buttonPrimaer }}</a>
<a class="btn-secondary" href="#services">{{ hero.buttonSekundaer }}</a>
</div>
</div>
</section>

<section aria-labelledby="services-title" class="section" id="services">
<div class="container">
<header class="section-head">
<div><span class="eyebrow">{{ d.leistungen.eyebrow }}</span><h2 id="services-title">{{ d.leistungen.titel }}</h2></div>
<p>{{ d.leistungen.intro }}</p>
</header>
<div class="service-grid">
{%- for c in d.leistungen.karten %}
<article class="service-card">
<a aria-hidden="true" tabindex="-1" class="service-card-media" href="side-pages/{{ c.seite }}.html">{{ image(c.img, c.alt, p) }}</a>
<p class="num">{{ loop.index | pad2 }}</p>
<h3><a href="side-pages/{{ c.seite }}.html">{{ c.titel }}</a></h3>
<p>{{ c.text }}</p>
<a class="text-link" href="side-pages/{{ c.seite }}.html" aria-label="{{ c.titel }} – mehr erfahren">Mehr erfahren <span aria-hidden="true">→</span></a>
</article>
{%- endfor %}
</div>
<div class="section-foot"><a class="btn-secondary" href="side-pages/leistungen.html">Alle Leistungen im Überblick</a></div>
</div>
</section>

<section aria-labelledby="highlights-title" class="section section--raised" id="highlights">
<div class="container">
<header class="section-head">
<div><span class="eyebrow">{{ d.arbeiten.eyebrow }}</span><h2 id="highlights-title">{{ d.arbeiten.titel }}</h2></div>
<p>{{ d.arbeiten.intro }} <a class="text-link" href="side-pages/projekte.html">Alle Referenzen <span aria-hidden="true">→</span></a></p>
</header>
<div class="work-grid highlights-strip">
{%- for w in d.arbeiten.projekte %}
<a aria-haspopup="dialog" class="hl-item portfolio-item" data-project-id="{{ w.projekt }}" href="side-pages/projekte.html#projekt={{ w.projekt }}">
<div class="hl-media">{{ image(w.img, w.alt, p) }}</div>
<div class="hl-caption"><span>{{ w.label }}</span><p>{{ w.titel }}</p></div>
</a>
{%- endfor %}
</div>
</div>
</section>

<section aria-labelledby="workflow-title" class="section" id="steps">
<div class="container">
<header class="section-head">
<div><span class="eyebrow">{{ d.ablauf.eyebrow }}</span><h2 id="workflow-title">{{ d.ablauf.titel }}</h2></div>
<p>{{ d.ablauf.intro }}</p>
</header>
<ol class="steps">
{%- for st in d.ablauf.schritte %}
<li><span class="num">{{ loop.index | pad2 }}</span><h3>{{ st.titel }}</h3><p>{{ st.text }}</p></li>
{%- endfor %}
</ol>
</div>
</section>

<section aria-labelledby="partner-title" class="partners" id="partner">
<div class="container partners-inner">
<h2 class="partners-title" id="partner-title">{{ d.partnerTitel }}</h2>
<div class="partner-logos">
{%- for pa in fnx.partners %}
{%- set cls = {"breit": "wide", "heller-hintergrund": "on-light"}[pa.darstellung] %}
<a{% if cls %} class="{{ cls }}"{% endif %} href="{{ pa.url }}" rel="noopener noreferrer" target="_blank" title="{{ pa.name }}"><img alt="{{ pa.name }}" decoding="async" height="{{ pa.img.height }}" loading="lazy" src="{{ pa.img.src }}" width="{{ pa.img.width }}"/></a>
{%- endfor %}
</div>
</div>
</section>

{%- set a = d.ueberMich %}
<section aria-labelledby="about-title" class="section section--raised" id="about">
<div class="container about-grid">
<div class="about-photo-wrap">
<div aria-label="Porträt von {{ a.name }} – beim Darüberfahren in Farbe" class="about-portrait has-portrait" tabindex="0">
<img alt="{{ a.alt }}" class="about-portrait-image about-portrait-image--bw" decoding="async" height="{{ a.bw.height }}" loading="lazy" src="{{ a.bw.src }}" width="{{ a.bw.width }}"/>
<img alt="" aria-hidden="true" class="about-portrait-image about-portrait-image--color" decoding="async" height="{{ a.color.height }}" loading="lazy" src="{{ a.color.src }}" width="{{ a.color.width }}"/>
{%- if a.fotoCredit %}
<span aria-hidden="true" class="about-portrait-hint">{{ a.fotoCredit }}</span>
{%- endif %}
</div>
</div>
<div class="about-text">
<span class="eyebrow">{{ a.eyebrow }}</span>
<h2 id="about-title">{{ a.name }}</h2>
<p class="about-lead">{{ a.lead }}</p>
{%- for para in a.absaetze %}
<p>{{ para }}</p>
{%- endfor %}
<dl class="about-facts">
{%- for f in a.fakten %}
<div><dt>{{ f.label }}</dt><dd>{{ f.wert }}</dd></div>
{%- endfor %}
</dl>
</div>
</div>
</section>

{{ faqBlock("faq", d.faq.titel, d.faq.intro, d.faq.fragen, "side-pages/faq.html") }}
{{ contactForm(fnx.settings, "Neue Anfrage über framenex.com", "https://framenex.com/?sent=1") }}
