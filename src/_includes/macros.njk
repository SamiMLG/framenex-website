{#- <img>, wrapped in <picture> when a phone-only version exists -#}
{%- macro image(img, alt, p, prio=false) -%}
{%- set tag -%}<img alt="{{ alt }}" decoding="async" height="{{ img.height }}" src="{{ p }}{{ img.src }}" width="{{ img.width }}"{% if prio %} fetchpriority="high"{% else %} loading="lazy"{% endif %}/>{%- endset -%}
{%- if img.mobile -%}<picture><source media="(max-width: 767px)" srcset="{{ p }}{{ img.mobile }}" type="image/webp"/>{{ tag | safe }}</picture>{%- else -%}{{ tag | safe }}{%- endif -%}
{%- endmacro -%}

{%- macro crumbs(items) -%}
<nav aria-label="Brotkrümelnavigation" class="breadcrumbs">{% for c in items %}{% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}{% if c[1] %}<a href="{{ c[1] }}">{{ c[0] }}</a>{% else %}<span aria-current="page">{{ c[0] }}</span>{% endif %}{% endfor %}</nav>
{%- endmacro -%}

{%- macro faqItems(fragen) -%}
{% for q in fragen %}<details class="faq-item"><summary><span class="faq-question">{{ q.frage }}</span><span aria-hidden="true" class="faq-icon"></span></summary><div class="faq-answer"><p>{{ q.antwort }}</p></div></details>
{% endfor %}
{%- endmacro -%}

{%- macro faqBlock(sid, titel, intro, fragen, link) -%}
<section aria-labelledby="{{ sid }}-title" class="section" id="{{ sid }}">
<div class="container faq-grid">
<header>
<span class="eyebrow">Häufige Fragen</span>
<h2 id="{{ sid }}-title">{{ titel }}</h2>
<p>{{ intro }}</p>
<a class="text-link" href="{{ link }}">Alle Fragen ansehen <span aria-hidden="true">→</span></a>
</header>
<div class="faq-list" data-faq-accordion="">
{{ faqItems(fragen) }}</div>
</div>
</section>
{%- endmacro -%}

{%- macro cta(titel, text, href) -%}
<section aria-labelledby="cta-title" class="cta-band">
<div class="container cta-band-inner">
<div>
<h2 id="cta-title">{{ titel }}</h2>
<p>{{ text }}</p>
</div>
<a class="btn-primary" href="{{ href }}">Erstgespräch anfragen</a>
</div>
</section>
{%- endmacro -%}

{%- macro contactForm(s, subject, redirect) -%}
{%- set k = s.kontaktformular -%}
<section aria-labelledby="contact-title" id="contact">
<div class="container contact-grid">
<div>
<span class="eyebrow">{{ k.eyebrow }}</span>
<h2 id="contact-title">{{ k.titel }}</h2>
<p>{{ k.text }}</p>
<div class="contact-direct">
<a href="mailto:{{ s.email }}">{{ s.email }}</a>
<a href="tel:{{ s.telefon | replace(' ', '') }}">{{ s.telefon }}</a>
</div>
</div>
<form action="https://api.web3forms.com/submit" class="contact-form" id="contactForm" method="POST" novalidate="">
<input name="access_key" type="hidden" value="{{ k.accessKey }}"/>
<input name="subject" type="hidden" value="{{ subject }}"/>
<input name="redirect" type="hidden" value="{{ redirect }}"/>
<div hidden="" aria-hidden="true"><label for="contact-botcheck">Bitte dieses Feld leer lassen</label><input class="form-botcheck" name="botcheck" type="checkbox" id="contact-botcheck" tabindex="-1" autocomplete="off"/></div>
<div class="form-row">
<div class="form-group"><label for="contact-name">Name</label><input autocomplete="name" id="contact-name" name="name" placeholder="Ihr Name" required="" type="text"/></div>
<div class="form-group"><label for="contact-email">E-Mail</label><input autocomplete="email" id="contact-email" name="email" placeholder="ihre@email.at" required="" type="email"/></div>
</div>
<div class="form-group"><label for="contact-subject">Leistung</label><select id="contact-subject" name="Anfrageart"><option value="">Bitte wählen…</option><option value="Videoproduktion">Videoproduktion / Film</option><option value="Fotografie">Fotografie</option><option value="Drohne">Drohnenaufnahmen</option><option value="Event">Event / Aftermovie</option><option value="Hochzeit">Hochzeitsfotografie / -videografie</option><option value="Postproduktion">Postproduktion / Videoschnitt</option><option value="Kurzfilm">Kurzfilm / Kinofilm</option><option value="Sonstiges">Sonstiges</option></select></div>
<div class="form-group"><label for="contact-message">Nachricht</label><textarea id="contact-message" name="message" placeholder="Worum geht es, wo und wann findet das Projekt statt?" required="" rows="5"></textarea></div>
<button class="btn-primary form-submit-btn" type="submit"><span class="btn-text">Nachricht senden</span><span aria-hidden="true" class="btn-spinner"></span></button>
<p aria-live="polite" class="form-success-msg" id="formSuccess"></p>
</form>
</div>
</section>
{%- endmacro -%}
